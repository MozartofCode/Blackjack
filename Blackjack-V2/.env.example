# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Omit for open access (dev mode).
# CORS_ORIGINS=https://casino.example.com,https://admin.example.com

# ─── Legacy Flask Backend (only needed if using the Flask bridge) ─────────────
GAME_ENGINE_URL=http://127.0.0.1:5000
REQUEST_TIMEOUT_MS=10000

# ─── Session Management ──────────────────────────────────────────────────────
# How long a session lives without activity (ms). Default: 30 minutes
SESSION_TTL_MS=1800000

# How often to sweep for expired sessions (ms). Default: 5 minutes
SESSION_CLEANUP_INTERVAL_MS=300000

# Maximum concurrent sessions
MAX_SESSIONS=100

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_MAX=100

# Rate limit window in minutes
RATE_LIMIT_WINDOW_MINUTES=1

# ─── Supabase (Persistent Database) ──────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
